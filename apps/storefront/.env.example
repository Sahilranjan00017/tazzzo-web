# Tazzzo storefront server configuration. The public /v1 API needs no credential; the only secret is the optional
# trusted-caller credential below, which comes from the deployment's secret store, never from this file.
# Values here are placeholders; real hosts come from the deployment environment.

# Base URL of the public Tazzzo API; /v1/** is appended. Called only from the Next.js server.
# Must be https in production (plain http only for a loopback host).
TAZZZO_API_BASE_URL=http://localhost:8080

# Public origin of this website (canonical and Open Graph URLs). Must be https in production.
TAZZZO_SITE_URL=http://localhost:3000

# The backend's media public base URL (the same value the backend joins asset keys with). Images are shown only from
# under this base and the CSP img-src allows only its origin. https only (plain http for loopback outside
# production). Unset: every image shows the placeholder.
TAZZZO_MEDIA_BASE_URL=

# Optional trusted-caller credential for the backend's admission gate (the storefront's own bucket instead of the
# shared per-IP one). Set both or neither. In production it REQUIRES STOREFRONT_TRUST_PROXY=true (fail closed:
# otherwise every page is a 500 naming STOREFRONT_TRUST_PROXY), so visitors are always limited before using it.
# Sent only from the Next.js server to TAZZZO_API_BASE_URL as X-Tazzzo-Caller / X-Tazzzo-Caller-Secret; never sent
# to the browser, never logged.
# NAME: [a-z][a-z_]{0,19}, not "unknown" (e.g. storefront). SECRET: 32-256 visible ASCII characters, no spaces (the backend's grammar).
TAZZZO_CALLER_NAME=
TAZZZO_CALLER_SECRET=

# Per-visitor rate limit for page requests (src/proxy.ts). In memory, PER INSTANCE: N instances admit up to N times
# these rates per visitor. Defaults shown; 0 per minute switches that bucket off.
# STOREFRONT_RATE_LIMIT_PER_MINUTE=60
# STOREFRONT_RATE_LIMIT_BURST=20
# Stricter bucket for the uncached paths: /search and paged category lists (/c/<node>?cursor=...).
# STOREFRONT_RATE_LIMIT_EXPENSIVE_PER_MINUTE=12
# STOREFRONT_RATE_LIMIT_EXPENSIVE_BURST=6
# Most visitors remembered at once (least recently seen are forgotten first).
# STOREFRONT_RATE_LIMIT_MAX_CLIENTS=10000

# The visitor address. Next.js gives the proxy no socket address it can trust, so WITHOUT this the per-visitor limit
# is inactive (one warning is logged). PRODUCTION MUST set true, behind proxies that append to X-Forwarded-For (the
# ALB), with the app unreachable except through them; HOPS = how many such proxies (1 = the ALB alone).
STOREFRONT_TRUST_PROXY=false
# STOREFRONT_TRUSTED_PROXY_HOPS=1
