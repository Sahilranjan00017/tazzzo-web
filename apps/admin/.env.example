# Example configuration for LOCAL DEVELOPMENT ONLY. Copy to apps/admin/.env.local (gitignored) and fill in real
# development values. Never commit real values: this repository is public.

# Origin of this CMS. Production must be https (cookies then use __Host- names + Secure).
CMS_BASE_URL=http://localhost:3000

# Google OAuth "Web application" client (development client for local work).
# CROSS-REPO INVARIANT: GOOGLE_CLIENT_ID must equal the backend's tazzzo.admin.oidc.audience for the same environment.
GOOGLE_CLIENT_ID=replace-with-dev-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-dev-client-secret
GOOGLE_HOSTED_DOMAIN=example.com

# Tazzzo backend base URL (server-to-server; never exposed to the browser).
TAZZZO_BACKEND_URL=http://localhost:8080

# Valkey/Redis for login transactions and sessions (production: rediss://).
SESSION_STORE_URL=redis://localhost:6379

# 32 random bytes, base64url: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_ENCRYPTION_KEY=generate-your-own-32-byte-key
# Optional previous key during rotation (decrypt only).
# SESSION_ENCRYPTION_PREVIOUS_KEY=

# Optional (defaults shown): absolute session cap and idle timeout, in seconds.
# CMS_SESSION_MAX_SECONDS=28800
# CMS_SESSION_IDLE_SECONDS=1800

# Optional: direct image upload (CMS media + home content). The ONE object-storage origin presigned PUT URLs point at,
# e.g. https://<bucket>.s3.ap-south-1.amazonaws.com. Added to CSP connect-src only; the BFF hands the browser an upload
# URL only on this exact origin. Unset = uploads are disabled in this deployment. Plain http only for a loopback store.
# CMS_MEDIA_UPLOAD_ORIGIN=
# Optional: the public media origin (CDN, e.g. https://cdn.tazzzo.com) for admin thumbnails. Added to CSP img-src only.
# CMS_MEDIA_PUBLIC_ORIGIN=
